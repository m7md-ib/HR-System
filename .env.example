# Local development (any local Postgres):
DATABASE_URL="postgresql://user:password@localhost:5432/mays_hr?schema=public"

# Production on Supabase: use the "Session pooler" connection string from
# Project Settings -> Database -> Connection string -> Session pooler.
# (Not the direct connection — it's IPv6-only, which Vercel can't reach.
#  Not the transaction pooler either — it doesn't support prepared statements,
#  which this app's Prisma driver adapter relies on.)
# DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres"

SESSION_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"

# Only needed in production (Vercel). Leave unset locally to keep saving
# uploads to /public/uploads on disk.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service_role-key-from-Project-Settings-API"
# SUPABASE_STORAGE_BUCKET="mays-hr-uploads"
